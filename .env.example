# Root-level env — used by qa-agent scripts (question seeding, QA runs).
# This is separate from apps/api/.env, which holds the running app's own
# runtime config (DATABASE_URL, JWT secrets, ATLAS_* content-generation keys).

DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""

# Models used for QA/seed question generation.
QA_OPENAI_MODEL="gpt-5.6-sol"
QA_OPENAI_REASONING_EFFORT="medium"
QA_DEEPSEEK_MODEL="deepseek-chat"

# Separate database for QA-agent seed data — never the real dev/prod DB.
QA_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wonderpath_qa?schema=public"

# Optional — QA agent findings get opened as Linear issues when both are
# set (skipped, not a failure, when either is missing). Team ID isn't
# secret; find it by querying your own key against Linear's API.
LINEAR_API_KEY=""
LINEAR_TEAM_ID=""
