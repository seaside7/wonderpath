DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wonderpath?schema=public"

JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Optional: separate signing secret for admin/staff tokens, keeping the
# parent and admin trust boundaries independent. Falls back to JWT_SECRET
# if unset.
ADMIN_JWT_SECRET=""

# Content Generation (Sprint 07)
# "mock" (default) uses the offline MockContentGenerator for local/e2e testing.
# "deepseek" requires ATLAS_DEEPSEEK_API_KEY — cheaper/simpler default for real generation.
# "openai" requires ATLAS_OPENAI_API_KEY — use when a task needs a stronger model.
ATLAS_CONTENT_PROVIDER="mock"

ATLAS_DEEPSEEK_API_KEY=""
ATLAS_DEEPSEEK_MODEL="deepseek-chat"

ATLAS_OPENAI_API_KEY=""
ATLAS_OPENAI_MODEL="gpt-4o-mini"

# Google Cloud Text-to-Speech — WaveNet voices (service-account auth)
# Point at the gitignored credentials JSON. Billing account "wonderpath" already
# set up in Google Cloud Console. Cloud Text-to-Speech API must be enabled.
GOOGLE_APPLICATION_CREDENTIALS="./google-tts-credentials.json"

TTS_VOICE_NAME="en-US-Neural2-F"

# Local audio file storage
TTS_UPLOADS_DIR="uploads/tts"

# Story Trail
BOOKS_ALLOW_PREVIEW="false"
BOOK_UPLOADS_DIR="uploads/books"
HIGGSFIELD_API_KEY=""
BOOK_AUDITOR_MODEL="gpt-4o-mini"
